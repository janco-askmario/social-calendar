# Copy this file to .env.local and fill in values from your Supabase project
# settings (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, server-only. Only needed if you add server-side admin actions
# (e.g. an API route that approves users). Never prefix this with NEXT_PUBLIC_
# and never import it from client components.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
